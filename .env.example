# ---- Server ----
PORT=5000
NODE_ENV=production
# Optional: long random string (32+ characters). If empty, the server makes one and keeps it in the database.
JWT_SECRET=

# ---- Database: TiDB Cloud (MySQL) ----
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=apostle_joshua
DB_SSL=true
DB_POOL_SIZE=3

# ---- Website address(es) allowed to call this API (comma-separated) ----
CLIENT_URLS=https://apostle-joshua-web.onrender.com
# Used in password-reset emails
CLIENT_URL=https://apostle-joshua-web.onrender.com

# ---- First admin (created on first start if no admin exists) ----
ADMIN_NAME=Apostle Joshua
ADMIN_EMAIL=
# Temporary: sign in once, then change it in Settings
ADMIN_TEMP_PASSWORD=

# ---- Photos (recommended: Render's disk is wiped on each deploy) ----
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ---- Email (optional): Brevo for reset links and new-request alerts ----
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Apostle Joshua Outreach
# Where prayer-request / message alerts go
NOTIFY_EMAIL=apostlejoshuaaogiriosa@gmail.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---- Chat assistant (optional) ----
# Free key from https://aistudio.google.com (no card needed). Without it the assistant
# still answers from your events, videos, settings and FAQs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
